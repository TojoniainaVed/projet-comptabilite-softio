APP_NAME="Softio Comptabilité"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Origines autorisées pour le frontend (séparées par des virgules)
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# PostgreSQL (voir README pour la création de la base)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=softio_comptabilite
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Durée de vie d'un jeton d'API, en minutes (8 heures par défaut)
SANCTUM_EXPIRATION=480

# E-mails (confirmation d'adresse, mot de passe oublié).
# « log » : les e-mails sont écrits dans storage/logs/laravel.log (développement : le lien s'y trouve).
# En production, utilisez « smtp » et renseignez les variables MAIL_* ci-dessous.


# Inscription en libre-service des clients
REGISTRATION_ENABLED=true
REGISTRATION_REQUIRE_EMAIL_VERIFICATION=true
# TERMS_URL=https://exemple.mg/conditions

# Mot de passe du compte super administrateur créé par le seeder.
# Laissé vide, un mot de passe aléatoire est généré et affiché une seule fois.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@softio.test

# Données de démonstration (comptes et entreprise « démo ») : jamais en production
DEMO_DATA=false
