# URL de base de l'API. Laisser /api/v1 en développement (le proxy Vite redirige vers Laravel sur :8000).
# En production : URL complète, par exemple https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Adresse du front de Softio (projet principal) : les comptes venus de Softio y retournent à la déconnexion.
VITE_SOFTIO_URL=http://localhost:5173
